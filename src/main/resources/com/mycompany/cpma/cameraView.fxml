<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="820.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CameraController">
   <children>
      <VBox alignment="CENTER" layoutX="14.0" layoutY="14.0" prefHeight="612.0" prefWidth="792.0" spacing="20.0">
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Captura de Foto para Cadastro">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <StackPane fx:id="cameraStack" prefHeight="480.0" prefWidth="640.0">
               <children>
                  <ImageView fx:id="cameraView" fitHeight="480.0" fitWidth="640.0" pickOnBounds="true" preserveRatio="true" />

                  <Ellipse fx:id="guiaFace" radiusX="135.0" radiusY="180.0" fill="transparent" stroke="#facc15" strokeWidth="4.0" mouseTransparent="true" />

                  <Label fx:id="lblOrientacao" mouseTransparent="true" text="Posicione seu rosto dentro do oval" textFill="WHITE" StackPane.alignment="BOTTOM_CENTER">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                     <padding>
                        <Insets bottom="14.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <StackPane.margin>
                        <Insets bottom="14.0" />
                     </StackPane.margin>
                     <style>
                        -fx-background-color: rgba(15, 23, 42, 0.65); -fx-background-radius: 8px;
                     </style>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </StackPane>

            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="btnIniciarCamera" mnemonicParsing="false" onAction="#iniciarCamera" prefHeight="40.0" prefWidth="150.0" text="Iniciar Câmera" />
                  <Button fx:id="btnCapturar" mnemonicParsing="false" onAction="#capturarFoto" prefHeight="40.0" prefWidth="180.0" text="Capturar Foto" visible="false" />
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" prefHeight="40.0" prefWidth="150.0" text="Cancelar" />
               </children>
            </HBox>

            <Label fx:id="lblStatus" alignment="CENTER" maxWidth="1.7976931348623157E308" text="Clique em 'Iniciar Câmera' para começar a captura">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
