<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.ApenadosController">
    <content>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-container">
                <TextField fx:id="txtFiltro" prefWidth="280.0" promptText="Filtrar por nome ou CPF..." />
                <Button onAction="#handleLimparFiltro" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-text-fill: #64748b; -fx-cursor: hand;" text="Limpar" />
                <Button onAction="#handleRecarregar" style="-fx-background-color: #f1f5f9; -fx-border-color: #2563eb; -fx-border-radius: 6px; -fx-text-fill: #2563eb; -fx-font-weight: 600; -fx-cursor: hand;" text="Atualizar" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnEditarApenado" onAction="#handleEditarApenado" prefHeight="36.0" style="-fx-background-color: #f1f5f9; -fx-border-color: #2563eb; -fx-border-radius: 6px; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-cursor: hand;" text="Editar Apenado" />
                <Button fx:id="btnGerarCodigoTotem" onAction="#handleGerarCodigoTotem" prefHeight="36.0" styleClass="btn-secondary" style="-fx-font-weight: bold; -fx-text-fill: #059669; -fx-border-color: #059669;" text="Gerar Código Totem" />
                <Button onAction="#handleNovoApenado" prefHeight="36.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" text="Cadastrar Novo Apenado" />
            </HBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS" styleClass="card-container">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Lista de Apenados Cadastrados" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Dica: Selecione um sentenciado para ver a ficha completa e processos." />
                </HBox>
                <TableView fx:id="tblApenados" prefHeight="420.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Codigo" />
                        <TableColumn fx:id="colNome" prefWidth="240.0" text="Nome Completo" />
                        <TableColumn fx:id="colCpf" prefWidth="140.0" text="CPF" />
                        <TableColumn fx:id="colTelefone" prefWidth="130.0" text="Telefone" />
                        <TableColumn fx:id="colBairro" prefWidth="140.0" text="Bairro" />
                        <TableColumn fx:id="colCidade" prefWidth="130.0" text="Cidade" />
                    </columns>
                    <placeholder>
                        <Label text="Nenhum apenado encontrado." style="-fx-text-fill: #94a3b8;" />
                    </placeholder>
                </TableView>
            </VBox>

            <VBox fx:id="paneDetalhes" spacing="12.0" styleClass="card-container" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #2563eb;" text="Ficha Individual:" />
                    <Label fx:id="lblDetalheNome" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="---" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDetalheCpf" style="-fx-text-fill: #64748b; -fx-font-weight: 600;" text="---" />
                    <Button onAction="#handleEditarApenado" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5px 12px; -fx-text-fill: #2563eb; -fx-border-color: #2563eb;" text="Editar Dados Cadastrais" />
                    <Button onAction="#handleImprimirDadosTrabalho" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5px 12px; -fx-text-fill: #2563eb; -fx-border-color: #2563eb;" text="Imprimir Ficha Completa" />
                    <Button onAction="#handleGerarCodigoTotem" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5px 12px; -fx-text-fill: #059669; -fx-border-color: #059669;" text="Gerar Código Totem" />
                </HBox>

                <GridPane hgap="16.0" vgap="6.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.0" />
                        <ColumnConstraints percentWidth="33.0" />
                        <ColumnConstraints percentWidth="34.0" />
                    </columnConstraints>
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Data de Nascimento" />
                        <Label fx:id="lblDetalheNascimento" style="-fx-text-fill: #1e293b;" text="---" />
                    </VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Endereco Completo" />
                        <Label fx:id="lblDetalheEndereco" style="-fx-text-fill: #1e293b;" text="---" />
                    </VBox>
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Telefone" />
                        <Label fx:id="lblDetalheTelefone" style="-fx-text-fill: #1e293b;" text="---" />
                    </VBox>
                </GridPane>

                <Separator />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Penas e Contratos Atribuidos a este Apenado" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnEditarPenaApenado" onAction="#handleEditarPenaApenado" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 4px 12px; -fx-background-radius: 4px; -fx-cursor: hand;" text="Editar Contrato Selecionado" />
                </HBox>
                <TableView fx:id="tblPenasApenado" prefHeight="140.0">
                    <columns>
                        <TableColumn fx:id="colPenaId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colPenaTipo" prefWidth="220.0" text="Tipo de Pena" />
                        <TableColumn fx:id="colPenaInstituicao" prefWidth="200.0" text="Instituicao" />
                        <TableColumn fx:id="colPenaHoras" prefWidth="90.0" text="Horas Totais" />
                        <TableColumn fx:id="colPenaInicio" prefWidth="110.0" text="Data Inicio" />
                        <TableColumn fx:id="colPenaTermino" prefWidth="110.0" text="Data Termino" />
                    </columns>
                    <placeholder>
                        <Label text="Nenhuma pena cadastrada para este apenado." style="-fx-text-fill: #94a3b8;" />
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
