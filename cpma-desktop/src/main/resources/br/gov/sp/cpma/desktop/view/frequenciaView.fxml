<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.FrequenciaController">
    <content>
        <VBox spacing="16.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <VBox spacing="12.0" styleClass="card-container">
                <Label style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Localizar Apenado para Lancamento de Horas e Folha de Ponto" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <TextField fx:id="txtCpfBusca" prefWidth="250.0" promptText="CPF do Apenado (apenas numeros)" />
                    <Button onAction="#handleBuscarApenado" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Localizar" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblApenadoNome" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;" text="Nenhum apenado selecionado" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Pena Ativa:" />
                    <ComboBox fx:id="cbPenas" maxWidth="Infinity" HBox.hgrow="ALWAYS" promptText="Selecione a pena correspondente..." />
                </HBox>
            </VBox>

            <VBox fx:id="boxResumo" spacing="10.0" styleClass="card-container" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #2563eb;" text="Status de Cumprimento da Pena" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblStatusCumprimento" styleClass="status-badge-online" text="EM CUMPRIMENTO" />
                </HBox>

                <ProgressBar fx:id="pbProgresso" maxWidth="Infinity" prefHeight="16.0" progress="0.0" />

                <HBox spacing="20.0">
                    <Label fx:id="lblHorasCumpridas" style="-fx-font-weight: 700; -fx-text-fill: #059669;" text="Cumpridas: 0h" />
                    <Label fx:id="lblHorasRestantes" style="-fx-font-weight: 700; -fx-text-fill: #dc2626;" text="Restantes: 0h" />
                    <Label fx:id="lblHorasTotais" style="-fx-font-weight: 700; -fx-text-fill: #64748b;" text="Total: 0h" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblPercentual" style="-fx-font-weight: 800; -fx-text-fill: #1e293b;" text="0.0%" />
                </HBox>
            </VBox>

            <VBox fx:id="boxFolhaMensal" spacing="14.0" styleClass="card-container" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #2563eb;" text="Geração da Folha de Ponto Mensal (Pelo Contrato Inicial)" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="O sistema projeta todos os dias acordados no mês. Apenas desmarque os dias em que o apenado faltou." />
                    </VBox>
                    <Label fx:id="lblTermosContrato" style="-fx-font-weight: 600; -fx-text-fill: #059669; -fx-background-color: #ecfdf5; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #a7f3d0; -fx-border-radius: 6px;" text="Contrato: ---" />
                </HBox>

                <Label fx:id="lblFeedbackFolhaMensal" maxWidth="Infinity" visible="false" wrapText="true" />

                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                    <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Mês de Referência:" />
                    <ComboBox fx:id="cbMesReferencia" prefWidth="150.0" />

                    <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Ano:" />
                    <ComboBox fx:id="cbAnoReferencia" prefWidth="95.0" />

                    <Button onAction="#handleGerarGradeMes" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6px 16px; -fx-background-radius: 6px;" text="Gerar Grade do Mês" />

                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleMarcarTodos" styleClass="btn-secondary" text="Marcar Todos" style="-fx-font-size: 11px; -fx-padding: 5px 10px;" />
                    <Button onAction="#handleDesmarcarTodos" styleClass="btn-secondary" text="Desmarcar Todos" style="-fx-font-size: 11px; -fx-padding: 5px 10px;" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 4px 0px;">
                    <Button onAction="#handleAdicionarDia" style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 12px;" text="Adicionar Dia" />
                    <Button onAction="#handleAdicionarMes" style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 12px;" text="Adicionar Mês Inteiro" />
                    <Button onAction="#handlePreencherHorariosPena" style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-font-size: 12px;" text="Preencher Horários da Pena" />
                    <Button onAction="#handleContinuarDeOndeParou" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #93c5fd; -fx-border-radius: 6px; -fx-font-size: 12px;" text="Continuar de Onde Parou" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleRemoverTudo" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: 700; -fx-cursor: hand; -fx-padding: 6px 12px; -fx-background-radius: 6px; -fx-border-color: #fca5a5; -fx-border-radius: 6px; -fx-font-size: 12px;" text="Limpar Grade" />
                </HBox>

                <TableView fx:id="tblFolhaMensal" editable="true" prefHeight="280.0">
                    <columns>
                        <TableColumn fx:id="colLotePresente" prefWidth="75.0" text="Presente?" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colLoteData" prefWidth="100.0" text="Data" />
                        <TableColumn fx:id="colLoteDia" prefWidth="110.0" text="Dia da Semana" />
                        <TableColumn fx:id="colLoteEntrada" prefWidth="75.0" text="Entrada" />
                        <TableColumn fx:id="colLoteAlmoco" prefWidth="75.0" text="Almoço" />
                        <TableColumn fx:id="colLoteVolta" prefWidth="75.0" text="Retorno" />
                        <TableColumn fx:id="colLoteSaida" prefWidth="75.0" text="Saída" />
                        <TableColumn fx:id="colLoteHoras" prefWidth="75.0" text="Horas" />
                        <TableColumn fx:id="colLoteStatus" prefWidth="95.0" text="Status" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colLoteObs" prefWidth="240.0" text="Atividades" />
                    </columns>
                    <placeholder>
                        <Label text="Clique em 'Gerar Grade do Mês' para carregar os dias previstos de trabalho." style="-fx-text-fill: #94a3b8;" />
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <Label fx:id="lblResumoFolhaMensal" style="-fx-font-weight: 700; -fx-text-fill: #1e293b; -fx-font-size: 13px;" text="Total de dias: 0 | Presenças: 0 | Faltas: 0 | Horas apuradas: 0.0h" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnConfirmarFolhaMensal" onAction="#handleConfirmarFolhaMensal" prefHeight="40.0" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 24px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Confirmar Presença e Registrar Folha de Ponto" />
                </HBox>
            </VBox>

            <TitledPane fx:id="paneAvulso" expanded="false" text="Lançamento Avulso de Comparecimento (Registro Individual)" styleClass="card-container" visible="false" managed="false">
                <VBox spacing="14.0">
                    <Label fx:id="lblFeedbackLancamento" maxWidth="Infinity" visible="false" wrapText="true" />

                    <GridPane hgap="14.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0" />
                            <ColumnConstraints percentWidth="35.0" />
                            <ColumnConstraints percentWidth="35.0" />
                        </columnConstraints>

                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Data da Atividade *" />
                            <DatePicker fx:id="dpDataTrabalho" maxWidth="Infinity" />
                        </VBox>

                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Instituição Parceira do Comparecimento" />
                            <ComboBox fx:id="cbInstituicaoFrequencia" maxWidth="Infinity" promptText="Instituição da pena ativa..." />
                        </VBox>

                        <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="1" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
                            <Label style="-fx-font-weight: 700; -fx-text-fill: #334155; -fx-font-size: 12px;" text="Batidas de Ponto e Intervalo de Trabalho" />
                            
                            <GridPane hgap="12.0" vgap="6.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="20.0" />
                                    <ColumnConstraints percentWidth="20.0" />
                                    <ColumnConstraints percentWidth="20.0" />
                                    <ColumnConstraints percentWidth="20.0" />
                                    <ColumnConstraints percentWidth="20.0" />
                                </columnConstraints>

                                <VBox spacing="4.0" GridPane.columnIndex="0">
                                    <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 11px;" text="1. Entrada" />
                                    <TextField fx:id="txtHorarioInicio" promptText="08:00" />
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="1">
                                    <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 11px;" text="2. Saída Almoço" />
                                    <TextField fx:id="txtHorarioAlmoco" promptText="12:00" />
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="2">
                                    <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 11px;" text="3. Retorno Almoço" />
                                    <TextField fx:id="txtHorarioVolta" promptText="13:00" />
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="3">
                                    <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 11px;" text="4. Saída Definitiva" />
                                    <TextField fx:id="txtHorarioSaida" promptText="17:00" />
                                </VBox>

                                <VBox spacing="4.0" GridPane.columnIndex="4">
                                    <Label style="-fx-font-weight: 700; -fx-text-fill: #2563eb; -fx-font-size: 11px;" text="Horas Líquidas *" />
                                    <TextField fx:id="txtHorasCumpridas" promptText="Ex: 8.0" style="-fx-font-weight: bold;" />
                                </VBox>
                            </GridPane>

                            <Label fx:id="lblCalculoAuto" style="-fx-text-fill: #059669; -fx-font-size: 11px; -fx-font-weight: 600;" text="Preencha os horários para cálculo automático de horas líquidas ou informe manualmente." />
                        </VBox>

                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Atividades Desenvolvidas e Observações do Dia" />
                            <TextField fx:id="txtAtividades" promptText="Ex: Serviços de manutenção predial, higienização, jardinagem, apoio em almoxarifado..." />
                        </VBox>
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button fx:id="btnSalvarRegistro" onAction="#handleSalvarRegistro" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 24px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Confirmar Presença Avulsa" />
                    </HBox>
                </VBox>
            </TitledPane>

            <VBox fx:id="boxHistorico" spacing="8.0" styleClass="card-container" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Histórico Completo de Comparecimentos Registrados" />
                </HBox>

                <TableView fx:id="tblHistorico" prefHeight="260.0">
                    <columns>
                        <TableColumn fx:id="colHistId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colHistData" prefWidth="95.0" text="Data" />
                        <TableColumn fx:id="colHistEntrada" prefWidth="75.0" text="Entrada" />
                        <TableColumn fx:id="colHistAlmoco" prefWidth="75.0" text="Almoço" />
                        <TableColumn fx:id="colHistVolta" prefWidth="75.0" text="Retorno" />
                        <TableColumn fx:id="colHistSaida" prefWidth="75.0" text="Saída" />
                        <TableColumn fx:id="colHistHoras" prefWidth="70.0" text="Horas" />
                        <TableColumn fx:id="colHistInstituicao" prefWidth="170.0" text="Instituição" />
                        <TableColumn fx:id="colHistObs" prefWidth="260.0" text="Atividades Realizadas" />
                    </columns>
                    <placeholder>
                        <Label text="Nenhum registro de trabalho lançado para esta pena." style="-fx-text-fill: #64748b;" />
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
