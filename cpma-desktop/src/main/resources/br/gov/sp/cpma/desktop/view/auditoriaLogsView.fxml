<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.AuditoriaLogsController">
    <content>
        <VBox spacing="20.0" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets bottom="32.0" left="28.0" right="28.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="CENTRAL DE AUDITORIA E LOGS DE SEGURANÇA" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Rastreabilidade de acessos ao Totem, detecção de tentativas de invasão e integridade de registros." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAtualizar" onAction="#handleAtualizar" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8px; -fx-cursor: hand;" text="Atualizar Logs" />
            </HBox>

            <GridPane hgap="16.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0" />
                    <ColumnConstraints percentWidth="25.0" />
                    <ColumnConstraints percentWidth="25.0" />
                    <ColumnConstraints percentWidth="25.0" />
                </columnConstraints>

                <VBox spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;" GridPane.columnIndex="0">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #64748b;" text="TOTAL DE REGISTROS" />
                    <Label fx:id="lblTotalLogs" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1e293b;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Todos os acessos auditados" />
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;" GridPane.columnIndex="1">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #059669;" text="ACESSOS AUTORIZADOS" />
                    <Label fx:id="lblTotalSucessos" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #059669;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Validações 2FA bem-sucedidas" />
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;" GridPane.columnIndex="2">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #dc2626;" text="TENTATIVAS BLOQUEADAS" />
                    <Label fx:id="lblTotalFalhas" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #dc2626;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Falhas de autenticação totais" />
                </VBox>

                <VBox spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;" GridPane.columnIndex="3">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: 800; -fx-text-fill: #b91c1c;" text="DIVERGÊNCIAS FACIAIS (RISCO)" />
                    <Label fx:id="lblFalhasBiometricas" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #b91c1c;" text="0" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Rosto divergente do titular" />
                </VBox>
            </GridPane>

            <VBox spacing="14.0" styleClass="card-container">
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <TextField fx:id="txtBuscaLogs" prefHeight="38.0" prefWidth="340.0" promptText="Buscar por Apenado, CPF, Código ou Ação..." styleClass="search-input-pill" />
                    
                    <CheckBox fx:id="chkApenasFalhas" onAction="#handleFiltroAlterado" style="-fx-font-weight: 700; -fx-text-fill: #dc2626; -fx-font-size: 12px;" text="Ver apenas tentativas suspeitas / bloqueadas" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 700;" text="Limite:" />
                    <ComboBox fx:id="cbLimite" prefHeight="36.0" prefWidth="90.0" />
                </HBox>

                <TableView fx:id="tblLogs" minHeight="420.0" prefHeight="450.0">
                    <columns>
                        <TableColumn fx:id="colDataHora" prefWidth="150.0" text="Data e Hora" />
                        <TableColumn fx:id="colStatus" prefWidth="130.0" text="Status / Risco" />
                        <TableColumn fx:id="colMetodo" prefWidth="160.0" text="Método" />
                        <TableColumn fx:id="colUsuario" prefWidth="240.0" text="Apenado Vinculado" />
                        <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                        <TableColumn fx:id="colMensagem" prefWidth="350.0" text="Ação / Detalhes do Sistema" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <VBox fx:id="paneDetalhes" spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;" visible="false" managed="false">
                    <Label style="-fx-font-weight: 800; -fx-font-size: 13px; -fx-text-fill: #1e293b;" text="🔍 Detalhes do Evento de Segurança Selecionado" />
                    <Label fx:id="lblDetalheTexto" style="-fx-font-size: 12px; -fx-text-fill: #334155;" wrapText="true" />
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
