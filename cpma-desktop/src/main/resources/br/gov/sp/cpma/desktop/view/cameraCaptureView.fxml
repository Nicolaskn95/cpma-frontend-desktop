<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="640.0" spacing="16.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.CameraCaptureController" style="-fx-background-color: #ffffff;">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="Captura Biométrica Facial" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBadgeConexao" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-border-color: #a7f3d0; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-padding: 3px 10px;" text="● Conectando..." />
        </HBox>
        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Posicione o apenado no centro do visor. O retângulo verde indicará a detecção facial em tempo real." wrapText="true" />
    </VBox>

    <StackPane VBox.vgrow="ALWAYS" minHeight="260.0" prefHeight="330.0" prefWidth="592.0" style="-fx-background-color: #090d16; -fx-background-radius: 10px; -fx-border-color: #1e293b; -fx-border-radius: 10px;">
        <ImageView fx:id="imgCameraLive" fitHeight="320.0" fitWidth="560.0" preserveRatio="true" />
        <VBox fx:id="paneCarregando" alignment="CENTER" spacing="12.0">
            <ProgressIndicator prefHeight="42.0" prefWidth="42.0" />
            <Label fx:id="lblOverlayStatus" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" text="Iniciando sensor da câmera..." />
        </VBox>
    </StackPane>

    <Label fx:id="lblFeedbackMensagem" maxWidth="Infinity" minHeight="22.0" style="-fx-font-size: 12px;" visible="false" managed="false" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" minHeight="52.0" prefHeight="52.0" spacing="12.0">
        <Button fx:id="btnCancelar" onAction="#handleCancelar" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-text-fill: #64748b; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-cursor: hand;" text="Cancelar" />
        <Button fx:id="btnTirarNovamente" onAction="#handleTirarNovamente" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-text-fill: #334155; -fx-font-weight: 600; -fx-padding: 8px 18px; -fx-cursor: hand;" text="🔄 Tirar Novamente" visible="false" managed="false" />
        <Button fx:id="btnCapturar" onAction="#handleBaterFoto" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 6px; -fx-padding: 8px 26px; -fx-cursor: hand; -fx-font-size: 13px;" text="📸 Bater Foto" />
        <Button fx:id="btnConfirmarFoto" onAction="#handleConfirmarFoto" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 6px; -fx-padding: 8px 24px; -fx-cursor: hand; -fx-font-size: 13px;" text="✅ Usar Esta Foto" visible="false" managed="false" />
    </HBox>
</VBox>
