                <Button fx:id="btnConfirmarCodigo" maxWidth="340.0" onAction="#handleValidarCodigo" prefHeight="50.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 15px; -fx-background-radius: 8px; -fx-cursor: hand;" text="Avançar para Reconhecimento Facial ➜" />
