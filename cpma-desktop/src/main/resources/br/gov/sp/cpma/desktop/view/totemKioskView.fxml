                    <GridPane hgap="16.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25.0" />
                            <ColumnConstraints percentWidth="25.0" />
                            <ColumnConstraints percentWidth="25.0" />
                            <ColumnConstraints percentWidth="25.0" />
                        </columnConstraints>

                        <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="TOTAL PREVISTO" />
                            <Label fx:id="lblTotemHorasTotais" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #475569;" text="0h" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #bbf7d0; -fx-border-radius: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #059669;" text="HORAS CUMPRIDAS" />
                            <Label fx:id="lblTotemHorasCumpridas" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #059669;" text="0.0h" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #ffffff; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #fecaca; -fx-border-radius: 8px;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="SALDO RESTANTE" />
