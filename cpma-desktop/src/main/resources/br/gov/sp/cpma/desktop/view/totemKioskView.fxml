                                <Label fx:id="lblProntuarioInstituicao" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #334155;" text="-" />
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="DATA DE INÍCIO" />
                                <Label fx:id="lblProntuarioDataInicio" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #334155;" text="-" />
                            </VBox>
