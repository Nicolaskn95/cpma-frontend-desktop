                                <ColumnConstraints percentWidth="33.33" />
                                <ColumnConstraints percentWidth="33.33" />
                                <ColumnConstraints percentWidth="33.33" />
                            </columnConstraints>

                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="NOME COMPLETO" />
                                <Label fx:id="lblProntuarioNome" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="-" />
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="CPF" />
                                <Label fx:id="lblProntuarioCpf" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="-" />
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="MATRÍCULA / CÓDIGO" />
                                <Label fx:id="lblProntuarioMatricula" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="-" />
