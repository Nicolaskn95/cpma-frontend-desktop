                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="PROGRESSO" />
                            <Label fx:id="lblTotemPercentual" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #2563eb;" text="0.0%" />
