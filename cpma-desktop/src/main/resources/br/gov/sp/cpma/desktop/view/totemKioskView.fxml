                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="MEDIDA ALTERNATIVA" />
                                <Label fx:id="lblProntuarioMedida" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #334155;" text="Prestação de Serviços à Comunidade (PSC)" />
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
