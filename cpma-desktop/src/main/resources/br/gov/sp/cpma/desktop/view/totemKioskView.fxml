                            <TableColumn fx:id="colRegistroInicio" prefWidth="90.0" text="Entrada" />
                            <TableColumn fx:id="colRegistroSaida" prefWidth="90.0" text="Saída" />
                            <TableColumn fx:id="colRegistroHoras" prefWidth="120.0" text="Horas Cumpridas" />
